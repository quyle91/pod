        "height_px": 96
      },
      "container_bounds": {
        "x": 1200,
        "y": 990,
        "max_width_px": 800,
        "max_height_px": 220,
        "cols": 6,
        "gap_px": 18,
        "gap_y_px": 16,
        "distribution": "grid"
      }
    },
    {
      "id": "recipient_name",
      "type": "text",
      "label": "Recipient / Main Name",
      "placeholder": "Enter name (e.g. Alex Henderson)",
      "default_value": "Alex",
      "position": {
        "x": 1200,
        "y": 1180
      },
      "style": {
        "font_family": "Montserrat",
        "font_weight": "700",
        "font_size_px": 120,
        "min_font_size_px": 36,
        "color": "#18181b",
        "align": "center",
        "max_width_px": 1050,
        "rotation": 0
      }
    },
    {
      "id": "slogan_text",
      "type": "text",
      "label": "Sub-Text / Slogan (Angled)",
      "placeholder": "Enter slogan (e.g. Vintage Legend Since 1990)",
      "default_value": "VINTAGE LEGEND",
      "position": {
        "x": 1200,
        "y": 1330
      },
      "style": {
        "font_family": "Oswald",
        "font_weight": "700",
        "font_size_px": 75,
        "min_font_size_px": 28,
        "color": "#4f46e5",
        "align": "center",
        "max_width_px": 950,
        "rotation": -8
      }
    }
