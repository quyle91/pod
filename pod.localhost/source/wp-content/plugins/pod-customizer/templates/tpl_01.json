        "x": 1200,
        "y": 820,
        "width_px": 260,
        "height_px": 200
      },
      "options": [
        {
          "id": "crown",
          "label": "Royal Crown",
          "url": "assets/cliparts/crown.svg"
        },
        {
          "id": "star",
          "label": "Golden Star",
          "url": "assets/cliparts/star.svg"
        },
        {
          "id": "heart",
          "label": "Love Heart",
          "url": "assets/cliparts/heart.svg"
        },
        {
          "id": "cat",
          "label": "Playful Cat",
          "url": "assets/cliparts/cat.svg"
        },
        {
          "id": "dog",
          "label": "Loyal Dog",
          "url": "assets/cliparts/dog.svg"
        }
      ]
    },
    {
      "id": "candle_count",
