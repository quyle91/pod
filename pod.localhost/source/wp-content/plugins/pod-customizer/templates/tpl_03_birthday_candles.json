{
  "id": "tpl_03",
  "name": "Birthday Celebration T-Shirt (Candles Repeater & Auto-Fit Text)",
  "category": "apparel",
  "product_title": "Custom Birthday Milestone T-Shirt",
  "print_spec": {
    "width_px": 2400,
    "height_px": 2400,
    "dpi": 300
  },
  "mockup": {
    "id": "tshirt_white",
    "name": "White T-Shirt",
    "url": "assets/mockups/tshirt-white.svg",
    "bounds": {
      "x": 650,
      "y": 650,
      "width": 1100,
      "height": 1200
    }
  },
  "fields": [
    {
      "id": "badge_icon",
      "type": "preset_picker",
      "label": "Celebration Icon",
      "default_value": "crown",
      "position": {
        "x": 1200,
        "y": 880,
        "width_px": 180,
        "height_px": 150
      },
      "options": [
        {
          "id": "crown",
          "label": "Birthday Crown",
          "url": "assets/cliparts/crown.svg"
        },
        {
          "id": "star",
          "label": "Superstar",
          "url": "assets/cliparts/star.svg"
        },
        {
          "id": "heart",
          "label": "Sweet Heart",
          "url": "assets/cliparts/heart.svg"
        }
      ]
    },
    {
      "id": "candle_count",
      "type": "repeater_counter",
      "label": "Milestone Age (Candles Count)",
      "default_value": 7,
      "min": 1,
      "max": 18,
      "sub_image": {
        "url": "assets/cliparts/candle.svg",
        "width_px": 46,
        "height_px": 92
      },
      "container_bounds": {
        "x": 1200,
        "y": 1040,
        "max_width_px": 750,
        "max_height_px": 220,
        "cols": 6,
        "gap_px": 16,
        "gap_y_px": 16,
        "distribution": "grid"
      }
    },
    {
      "id": "recipient_name",
      "type": "text",
      "label": "Birthday Person Name",
      "placeholder": "Enter name (e.g. Nam Anh)",
      "default_value": "Nam Anh",
      "position": {
        "x": 1200,
        "y": 1220
      },
      "style": {
        "font_family": "Montserrat",
        "font_weight": "700",
        "font_size_px": 96,
        "min_font_size_px": 30,
        "color": "#18181b",
        "align": "center",
        "max_width_px": 950,
        "rotation": 0
      }
    },
    {
      "id": "birthday_wishes",
      "type": "text",
      "label": "Greeting / Message",
      "placeholder": "Enter wishes (e.g. Wishing you endless joy!)",
      "default_value": "Happy Birthday!",
      "position": {
        "x": 1200,
        "y": 1350
      },
      "style": {
        "font_family": "Dancing Script",
        "font_weight": "600",
        "font_size_px": 64,
        "min_font_size_px": 24,
        "color": "#ec4899",
        "align": "center",
        "max_width_px": 850,
        "rotation": 0
      }
    }
  ]
}
